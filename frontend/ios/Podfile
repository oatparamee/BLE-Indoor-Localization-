# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'BLEIndoorLocalization' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'BLEIndoorLocalizationTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # React Native 0.76 generates one Codegen script phase that invokes
    # with-environment.sh without quoting paths. That breaks when the repo path
    # contains spaces, such as this project's "ECE 180" parent folder.
    installer.pods_project.targets.each do |target|
      target.shell_script_build_phases.each do |phase|
        if target.name == 'ReactCodegen' && phase.shell_script&.include?('$WITH_ENVIRONMENT $SCRIPT_PHASES_SCRIPT')
          phase.shell_script = phase.shell_script.gsub(
            '/bin/sh -c "$WITH_ENVIRONMENT $SCRIPT_PHASES_SCRIPT"',
            ". \"$WITH_ENVIRONMENT\"\n\"$SCRIPT_PHASES_SCRIPT\""
          )
        end

        if target.name == 'hermes-engine'
          phase.shell_script = phase.shell_script
            &.gsub(
              '. ${REACT_NATIVE_PATH}/sdks/hermes-engine/utils/build-hermesc-xcode.sh ${PODS_ROOT}/hermes-engine/build_host_hermesc ${REACT_NATIVE_PATH}/ReactCommon/jsi',
              '. "${REACT_NATIVE_PATH}/sdks/hermes-engine/utils/build-hermesc-xcode.sh" "${PODS_ROOT}/hermes-engine/build_host_hermesc" "${REACT_NATIVE_PATH}/ReactCommon/jsi"'
            )
            &.gsub(
              '. ${REACT_NATIVE_PATH}/sdks/hermes-engine/utils/build-hermes-xcode.sh 0.76.9 ${PODS_ROOT}/hermes-engine/build_host_hermesc/ImportHermesc.cmake ${REACT_NATIVE_PATH}/ReactCommon/jsi',
              '. "${REACT_NATIVE_PATH}/sdks/hermes-engine/utils/build-hermes-xcode.sh" 0.76.9 "${PODS_ROOT}/hermes-engine/build_host_hermesc/ImportHermesc.cmake" "${REACT_NATIVE_PATH}/ReactCommon/jsi"'
            )
        end
      end
    end

    # Xcode 26 / Apple Clang trips over fmt's C++20 consteval format checks
    # in React Native 0.76's fmt pod. Keep fmt on its runtime-check path.
    fmt_base = File.join(__dir__, 'Pods', 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base)
      File.chmod(0644, fmt_base)
      contents = File.read(fmt_base)
      contents.gsub!(
        "#elif defined(__apple_build_version__) && __apple_build_version__ < 14000029L\n#  define FMT_USE_CONSTEVAL 0  // consteval is broken in Apple clang < 14.",
        "#elif defined(__apple_build_version__)\n#  define FMT_USE_CONSTEVAL 0  // consteval is broken in Apple clang for this RN/fmt/Xcode combination."
      )
      File.write(fmt_base, contents)
    end
  end
end
